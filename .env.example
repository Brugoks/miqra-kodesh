VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=
VITE_CANVA_CLIENT_ID=
VITE_CANVA_REDIRECT_URI=http://localhost:5176/?integration=canva
VITE_CONSTANT_CONTACT_CLIENT_ID=
VITE_CONSTANT_CONTACT_REDIRECT_URI=http://localhost:5176/?integration=constant-contact

# Optional: public base URL for generated Bible Wiki default images hosted outside Supabase.
# Example: https://wiki-images.your-domain.com
VITE_WIKI_IMAGE_BASE_URL=

# Optional: Thunderforest API key for the Scripture Lookup passage map. When set,
# the map uses Thunderforest 'atlas' tiles with lang=en so cities/countries are
# labeled in English; without it the map falls back to a label-free basemap.
# Free "Hobby" key at https://www.thunderforest.com/ — restrict it to your
# domain(s) under the key's settings, since it ships in the client bundle.
VITE_THUNDERFOREST_KEY=

# Required: CARTO now enforces an API key on basemaps.cartocdn.com (as of late
# August 2026) — unauthenticated tile requests get an "API KEY REQUIRED"
# watermark. Powers the label-free basemap in PassageMap.jsx (Thunderforest
# fallback) and the Ancient World Atlas (/atlas). Free key, no approval queue,
# at https://carto.com/basemaps/apikey/ — 5M tile requests/month fair-use
# limit. Ships in the client bundle like the Thunderforest key above (tile
# requests can't be proxied — a single pan fires dozens of them); check
# CARTO's dashboard for a referrer/domain restriction and enable it if offered.
VITE_CARTO_API_KEY=

# Edge Function secrets (server-side only — never use VITE_ prefix for these)
# Set in production via: supabase secrets set API_BIBLE_KEY=... --linked
API_BIBLE_KEY=
ESV_API_KEY=

# Fish Audio voice-clone TTS (server-side only — never expose in the client bundle).
# Voice registry: FISH_VOICE_1_ID / FISH_VOICE_1_LABEL, FISH_VOICE_2_ID / _2_LABEL, …
# label is optional (falls back to "Voice N"). The app's "Read aloud" selector
# lists these; the client never sees the API key.
# Serving a cloned voice to end-users requires a PAID Fish Audio plan.
FISH_API_KEY=
FISH_VOICE_1_ID=
FISH_VOICE_1_LABEL=
# Cost guardrails (Fish is billed per character; synthesized output is cached in
# the private tts-cache bucket, so only NEW chars count against these caps).
# Per-user daily character budget (default 20000 if unset; 0 disables).
FISH_DAILY_CHAR_LIMIT=20000
# Optional global daily backstop across all users (0/unset disables).
FISH_GLOBAL_DAILY_CHAR_LIMIT=
WIKIDATA_USER_AGENT=MiqraKodeshScriptureLookup/0.1 (https://your-domain.example; contact@example.com)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Miqra Kodesh
OPENROUTER_ALLOW_PAID_MODELS=false
VITE_GIPHY_API_KEY=

# Cloudflare R2 migration-only credentials for scripts/migrate-wiki-images-to-r2.js.
# Do not expose these with VITE_ prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Local dev auth bypass (optional). Set to your own account's email and `npm run
# dev` will sign you in automatically via a service-role magic-link token that
# never reaches the browser. Never set in production; the plugin is dev-server only.
DEV_LOGIN_EMAIL=
