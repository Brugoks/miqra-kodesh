VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=
VITE_CANVA_CLIENT_ID=
VITE_CANVA_REDIRECT_URI=http://localhost:5176/?integration=canva
VITE_CONSTANT_CONTACT_CLIENT_ID=
VITE_CONSTANT_CONTACT_REDIRECT_URI=http://localhost:5176/?integration=constant-contact

# Optional: public base URL for generated Bible Wiki default images hosted outside Supabase.
# Example: https://wiki-images.your-domain.com
VITE_WIKI_IMAGE_BASE_URL=

# Edge Function secrets (server-side only — never use VITE_ prefix for these)
# Set in production via: supabase secrets set API_BIBLE_KEY=... --linked
API_BIBLE_KEY=
ESV_API_KEY=
WIKIDATA_USER_AGENT=MiqraKodeshScriptureLookup/0.1 (https://your-domain.example; contact@example.com)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Miqra Kodesh
OPENROUTER_ALLOW_PAID_MODELS=false
VITE_GIPHY_API_KEY=

# Cloudflare R2 migration-only credentials for scripts/migrate-wiki-images-to-r2.js.
# Do not expose these with VITE_ prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
